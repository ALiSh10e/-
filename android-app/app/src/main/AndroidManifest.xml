<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yemen.lughati">

    <!-- 
      تأكيد أمني صارم:
      لا يوجد أي إذن إنترنت (INTERNET permission غير موجود نهائياً).
      التطبيق يعمل محلياً 100% دون أي اتصال خارجي.
    -->

    <!-- إذن اختياري للميكروفون فقط لمقارنة نطق الطفل محلياً دون إرساله لأي جهة -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LughatiYemen">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.lesson.LessonDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.quiz.QuizActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.letters.LetterLibraryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.parents.ParentDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
